{
  "manifest_version": 2,
  "name": "Toastr",
  "version": "1.0",

  "description": "Comment on any given website",

  "icons": {
    "48": "icons/border-48.png"
  },
  "background": {
    "page": "index.html",
    "persistent": false
  },
  "content_security_policy": "worker-src 'self'; script-src 'self' 'wasm-unsafe-eval'",
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["extension.js"]
    }
  ],
  "host_permissions": [
    "*://toastr.tylerfreedman.com/*"
  ],
  "permissions": [
    "webRequest",
    "unlimitedStorage",
    "activeTab",
    "tabs"
  ],
  "browser_action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/bread_16.png",
      "32": "icons/bread_32.png",
      "64": "icons/bread_64.png"
    }
  }
}
