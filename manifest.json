{
  "manifest_version": 2,
  "name": "Toastr",
  "version": "1.0",

  "description": "Comment on any given website",

  "icons": {
    "48": "icons/border-48.png"
  },
  "background": {
    "page": "background.html",
    "persistent": false
  },
  "content_security_policy": "worker-src 'self'; script-src 'self' 'wasm-unsafe-eval'",
  "content_scripts": [
    {
      "matches": ["*://*.mozilla.org/*"],
      "js": ["toastr.js"]
    }
  ],
  "host_permissions": [
    "*://toastr.tylerfreedman.com/*"
  ],
  "permissions": [
    "webRequest",
    "unlimitedStorage"
  ],
  "web_accessible_resources": [
    "sql-wasm.wasm"
  ],
  "browser_action": {
    "default_popup": "popup/choose_page.html",
    "default_icon": {
      "16": "icons/page-16.png",
      "32": "icons/page-32.png"
    }
  }
}
