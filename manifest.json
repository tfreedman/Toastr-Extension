{
  "manifest_version": 2,
  "name": "Toastr",
  "version": "1.0",

  "description": "Adds a red border to all webpages matching mozilla.org.",

  "icons": {
    "48": "icons/border-48.png"
  },

  "content_scripts": [
    {
      "matches": ["*://*.mozilla.org/*"],
      "js": ["sql-wasm.js", "toastr.js"]
    }
  ],

  "web_accessible_resources": [
    "sql-wasm.wasm"
  ]
}
